{
  "name": "@velocity-bpa/n8n-nodes-polygon",
  "version": "1.0.0",
  "description": "n8n community node for Polygon blockchain RPC operations",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "",
  "author": {
    "name": "Velocity BPA",
    "email": "info@velocitybpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/velocity-bpa/n8n-nodes-polygon.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint nodes credentials --ext .ts",
    "lint:fix": "eslint nodes credentials --ext .ts --fix"
  },
  "files": [
    "dist/**/*"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PolygonApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Polygon/Polygon.node.js"
    ]
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "polygon",
    "blockchain",
    "ethereum",
    "rpc",
    "crypto"
  ],
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.56.0",
    "n8n-workflow": "1.57.0",
    "typescript": "^5.5.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "axios": "^1.7.2"
  }
}